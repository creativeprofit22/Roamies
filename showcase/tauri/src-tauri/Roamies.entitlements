<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime blocks the microphone unless it's declared; the voice helper needs it. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- The bundled Node.js (Sidekick's brain) runs V8, which compiles JavaScript at runtime: without these
       the hardened runtime kills it on launch. Same entitlements Node's own macOS builds are signed with. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
