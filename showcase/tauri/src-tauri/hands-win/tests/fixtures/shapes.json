{
  "_comment": "Key sets of every reply roamies-hands prints on Windows (see docs/hands.md). Checked by protocol.rs tests. The macOS helper prints the same keys minus unit, monitors, scale and the OCR ones (source, uiOcr, ocrTiming, ocrFile).",
  "windowInfo": ["app", "bounds", "id", "scale", "title"],
  "monitor": ["bounds", "origin", "primary", "scale"],
  "windows": ["monitors", "ok", "unit", "windows"],
  "locate": ["monitors", "ok", "unit", "window"],
  "locateScreen": ["monitors", "ok", "unit", "what"],
  "captureWindow": ["file", "monitors", "ok", "sent", "unit", "window"],
  "captureScreen": ["bounds", "file", "monitors", "ok", "sent", "unit", "what"],
  "ui": ["controls", "elsewhere", "note", "ok", "source", "texts", "unit", "window"],
  "uiOcr": ["ocr", "ocrLang", "ocrMs"],
  "ocrTiming": ["ocrLang", "ocrMs"],
  "ocrLine": ["bounds", "text", "words"],
  "ocrWord": ["bounds", "text"],
  "ocrFile": ["lang", "lines", "ocrMs", "ok", "source", "unit"],
  "image": ["file", "ok", "sent", "unit"],
  "control": ["bounds", "id", "label", "role"],
  "controlOptional": ["focused", "offscreen", "value"],
  "findText": ["matches", "ok", "unit"],
  "match": ["bounds", "match", "rank", "role", "source", "text", "window"],
  "act": ["done", "ok", "unit", "window"],
  "actChanged": ["controls", "done", "ok", "texts", "unit", "window"],
  "actError": ["code", "done", "error", "ok"],
  "error": ["code", "error", "ok"],
  "partial": ["partial", "partialReason"]
}
